{
  "name": "github-events-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Event-only MCP server for GitHub notifications",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun build --compile --target=bun-windows-x64 --windows-hide-console --outfile=dist/github-events-mcp.exe src/main.ts",
    "build:local": "bun build --compile --outfile=dist/github-events-mcp src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "ci": "bun test && tsc --noEmit"
  },
  "dependencies": {
    "@github-events-mcp/events": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
